{
  "name": "bandloop",
  "version": "0.1.0",
  "description": "Studio audio multipiste de bureau (Electron + Web Audio)",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "samples": "node scripts/generate-samples.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bandloop.app",
    "productName": "Bandloop",
    "files": ["src/**/*", "package.json"],
    "mac": { "target": ["dmg"], "category": "public.app-category.music" },
    "win": { "target": ["nsis"] }
  }
}
